# coupang-deals — 비밀정보 템플릿. 이 파일을 복사해 .env 로 만들고 값만 채운다.
#   copy .env.example .env
# .env 는 gitignore 되어 있다. 값은 절대 채팅·커밋·스크린샷에 올리지 않는다.

# ── 쿠팡 파트너스 API (파트너스 로그인 → Tools → 파트너스 API) ──
# 최종승인 계정에서만 발급된다. 운영자(계정 명의자) 본인이 발급한다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── 텔레그램 (@BotFather 로 봇 생성 → 토큰 / 채널에 봇을 관리자로 추가) ──
TELEGRAM_BOT_TOKEN=
# 공개 채널이면 @채널아이디, 비공개면 -100 으로 시작하는 숫자 ID
TELEGRAM_CHANNEL_ID=

# ── 선택: AI 한 줄 요약용 (없으면 요약 칸은 스펙 기반 문구로 대체) ──
GEMINI_API_KEY=

# ── 워드프레스 게시 (둘 중 하나) ──
# B) WordPress.com 호스팅형 (luvssol.wordpress.com 처럼 *.wordpress.com)
#    developer.wordpress.com/apps 에서 앱 생성 → 아래 3개 → `uv run python scripts/wpcom_auth.py` 가 WPCOM_TOKEN 을 채운다
WPCOM_SITE=
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_TOKEN=
# A) 자체 호스팅 (카페24 등) — 응용 프로그램 비밀번호
WP_URL=
WP_USER=
WP_APP_PASSWORD=
